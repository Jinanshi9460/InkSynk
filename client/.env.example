# Copy to client/.env.local for local development (never commit the real file).
# URL of the Socket.IO server, no trailing slash. Read at BUILD time by Vite.
#
# Local dev:  http://localhost:3000
# Production: set this in your hosting dashboard (e.g. Render "Environment"), NOT in a committed file:
#             VITE_SERVER_URL=https://your-server.onrender.com
VITE_SERVER_URL=http://localhost:3000
