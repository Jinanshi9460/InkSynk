# Copy to server/.env for local development (never commit the real .env)

# Port the server listens on. Render (and most hosts) set PORT automatically: do not hardcode it there.
PORT=3000

# Allowed frontend origin(s) for CORS, comma-separated, no trailing slash.
# Local dev:  http://localhost:5173
# Production: your deployed client URL, e.g. https://your-client.onrender.com
CLIENT_URL=http://localhost:5173

# Optional: maximum number of rooms alive at once (memory safety cap). Default 500.
# MAX_ROOMS=500

# TESTING ONLY: shorten every game timer (0 < value <= 1, e.g. 0.1 = 10x faster).
# Ignored when NODE_ENV=production. Leave unset for real games.
# GAME_TIME_SCALE=0.1
